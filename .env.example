# Copy to .env and fill in. Never commit real secrets.
# docker compose reads this file automatically.

AUTH_USERNAME=change-me
AUTH_PASSWORD=change-me-to-a-long-random-secret

# Optional URL prefix for /analyse and /position. Health stays on /ping.
# APP_PREFIX=/v1/chess

# Lucene — build with `make index-sample` or `make index` first.
# Searcher is opened once per process. Default page size is 20.
# LUCENE_TOP_K=20

# The compose image sets these. For a host-run jar, point the CLI at python-server/.
# CHESSAPP_DIR=python-server
# STOCKFISH_PATH=python-server/engine/stockfish
# PORT=8081

# Flask `main:app` only (not the compose server): in-process LRU and the engine lock.
# CACHE_MAX_ENTRIES=256
# CACHE_TTL_SECONDS=3600
# STOCKFISH_LOCK_TIMEOUT_SECONDS=0
