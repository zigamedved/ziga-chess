# Copy to .env and fill in. Never commit real secrets.
# Previous hardcoded Basic auth credentials are revoked — set new ones.

AUTH_USERNAME=change-me
AUTH_PASSWORD=change-me-to-a-long-random-secret

# Python → Java search hop (default matches local java-server)
JAVA_SERVICE_URL=http://127.0.0.1:8080/position

# Optional URL prefix for both services (Docker build-arg PREFIX / APP_PREFIX)
# APP_PREFIX=/v1/chess

# Lucene index directory for java-server (build with `make index`)
# LUCENE_INDEX_DIR=java-server/indexedFiles
# LUCENE_TOP_K=50

# Optional: Stockfish binary override for python-server
# STOCKFISH_PATH=engine/stockfish
