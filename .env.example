# Copy to .env and fill in. Never commit real secrets.
# docker compose reads this file automatically.

AUTH_USERNAME=change-me
AUTH_PASSWORD=change-me-to-a-long-random-secret

# Optional URL prefix for both services (must match). Leave empty locally.
# When set, Python hops to http://java-server:8080${APP_PREFIX}/position
# APP_PREFIX=/v1/chess

# Lucene (java-server) — build with `make index-sample` or `make index` first
# LUCENE_TOP_K=50

# Local (non-compose) Python → Java hop
# JAVA_SERVICE_URL=http://127.0.0.1:8080/position

# Local Stockfish (after ./scripts/download_stockfish.sh)
# STOCKFISH_PATH=python-server/engine/stockfish
